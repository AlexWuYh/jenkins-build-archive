# Jenkins Build Archive configuration
# Copy to .env and replace values before production use.

# Required for Jenkins write/API: long random string.
API_TOKEN=replace-with-a-long-random-token

# Required for Web UI admin (delete / batch delete / retention settings).
# Prefer a short memorable password for operators; not the same as API_TOKEN.
ADMIN_PASSWORD=replace-with-admin-password

TZ=Asia/Shanghai

# Default retention when not overridden in the Admin UI (0 = disabled).
# UI-saved values are stored in SQLite and take precedence.
RETENTION_DAYS=0
RETENTION_MAX_PER_JOB=0
